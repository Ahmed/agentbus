{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent claude",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
