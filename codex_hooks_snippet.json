{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __AGENTBUS_DIR__/session_hook.py --agent codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
